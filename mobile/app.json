{
  "expo": {
    "name": "Recount",
    "slug": "recount",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F6F2E8",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.recount.mobile"
    },
    "android": {
      "package": "app.recount.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#F6F2E8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Recount uses your photos so you can pick a picture of your hospital bill.",
          "cameraPermission": "Recount uses the camera so you can take a picture of your hospital bill."
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "7fefde0f-2c5e-493f-8362-e9475ec85347"
      }
    },
    "owner": "vovaborysenko",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7fefde0f-2c5e-493f-8362-e9475ec85347"
    }
  }
}